# Copy to .env.local for local development. Never commit real secrets.

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Analytics: GA4 measurement ID for www.pillora.in (public value; also set in vercel.json / Vercel dashboard)
NEXT_PUBLIC_GA4_ID=
# Google Search Console HTML-tag verification token (content="..." value only). Optional:
# the file-based verification in public/googleaf5e9864ac71c5e2.html keeps working either way.
NEXT_PUBLIC_GSC_VERIFICATION=

# Real-time (Socket.io) server. Leave empty unless a long-running socket server exists;
# Vercel serverless cannot host websockets.
NEXT_PUBLIC_SOCKET_URL=
